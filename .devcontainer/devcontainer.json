{
  "name": "helpers4",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  // Named volumes, not host bind-mounts — bind-mounting `../<repo>` only works
  // for a local Docker Desktop/WSL2 checkout with every repo pre-cloned side
  // by side; it silently breaks GitHub Codespaces, which only ever checks out
  // the one repo the codespace was launched from. A named volume survives
  // "Rebuild Container" on the same Docker host/Codespace; only a full
  // teardown (`docker volume rm`, deleted Codespace) resets it to a fresh
  // clone via setup-container.sh.
  "mounts": [
    "source=helpers4-repo-github,target=/workspaces/.github,type=volume",
    "source=helpers4-repo-action,target=/workspaces/action,type=volume",
    "source=helpers4-repo-devcontainer,target=/workspaces/devcontainer,type=volume",
    "source=helpers4-repo-typescript,target=/workspaces/typescript,type=volume",
    "source=helpers4-repo-website,target=/workspaces/website,type=volume"
  ],
  "containerEnv": {
    "HELPERS4_ORG": "helpers4",
    "HELPERS4_REPOS": ".github action devcontainer typescript website",
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "features": {
    // ── Node.js override (mcr typescript-node:26 doesn't exist yet — Node 26
    //    ships without Temporal flag but isn't LTS until Oct 2026, so MS
    //    hasn't published a devcontainers/typescript-node:26 image). Installs
    //    Node 26 via nvm on top of the image's baked-in Node 24; remove once
    //    typescript-node:26 is published upstream and bump "image" instead.
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/dotfiles-sync:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {},
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "helpers4",
      "license": "LGPL-3.0-or-later"
    },
    // ── AI ───────────────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1.0.7": {},
    "ghcr.io/helpers4/devcontainer/mistral-dev:1": {},
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "packs": "peasant_fr,peon_fr,warcraft-peon"
    },
    // ── JavaScript ───────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck"
      ]
    }
  },
  // Only `website` (Astro) runs a dev server; other repos have none to forward.
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "website — Astro dev server",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node",
  "initializeCommand": "mkdir -p ~/.claude",
  "onCreateCommand": "git config --local --unset core.hooksPath || true",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}