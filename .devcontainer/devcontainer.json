{
  "name": "helpers4",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "containerEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "features": {
    // ── Node.js override (mcr typescript-node:26 doesn't exist yet — Node 26
    //    ships without Temporal flag but isn't LTS until Oct 2026, so MS
    //    hasn't published a devcontainers/typescript-node:26 image). Installs
    //    Node 26 via nvm on top of the image's baked-in Node 24; remove once
    //    typescript-node:26 is published upstream and bump "image" instead.
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork",
      "exclude": "helpers4.github.io"
    },
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/dotfiles-sync:1": {},
    "ghcr.io/helpers4/devcontainer/shell-history-per-project:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {},
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "helpers4",
      "license": "LGPL-3.0-or-later"
    },
    // ── AI ───────────────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {},
    "ghcr.io/helpers4/devcontainer/mistral-dev:1": {},
    "ghcr.io/helpers4/devcontainer/cline-dev:1": {},
    "ghcr.io/helpers4/devcontainer/peon-ping:1": {
      "healHostRelay": true
    },
    // ── JavaScript ───────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck"
      ]
    }
  },
  // Only `website` (Astro) runs a dev server; other repos have none to forward.
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "website — Astro dev server",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node",
  // Runs on the HOST before the container exists — the only devcontainer lifecycle hook that
  // does, which is why peon-ping's own README asks every consumer to paste this in rather
  // than trying to do it from the Feature itself (not possible — see that README's "Why a
  // Feature can't just fix this itself"):
  //   1. Reads this HOST's peon-ping config (if any) and hands its active pack to the
  //      container through a read-only Docker volume — see "Discovering your host's
  //      peon-ping" in the peon-ping Feature's README. Never writes to the host itself.
  //   2. Starts the audio relay for real if `peon` is installed here — matches `healHostRelay:
  //      true` below, this org's explicit, versioned opt-in to letting this Feature touch the
  //      host at all for the relay specifically (off by default otherwise). Not a printed
  //      "run this yourself" message, an actual command that runs on every container start.
  //      No --bind=<gateway-ip>: that IP is only knowable from inside a running container
  //      (see peon-ping's README "Automating the relay"), which doesn't exist yet at this
  //      point — accepting the relay's own default bind address instead of a per-container
  //      narrower one.
  "initializeCommand": "mkdir -p ~/.claude; p=$(python3 -c \"import json,os,re;c=os.path.expanduser('~/.claude/hooks/peon-ping/config.json');v=json.load(open(c)).get('default_pack','') if os.path.exists(c) else '';print(v if re.match('^[A-Za-z0-9_.-]+$',v) else '')\"); [ -n \"$p\" ] && docker run --rm -e PACK=\"$p\" -v helpers4-peon-ping-hostinfo-${devcontainerId}:/d busybox sh -c 'echo \"$PACK\" > /d/pack'; command -v peon >/dev/null 2>&1 && peon relay --daemon >/dev/null 2>&1; true",
  "onCreateCommand": "git config --local --unset core.hooksPath || true"
}