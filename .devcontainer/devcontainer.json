{
  "name": "helpers4",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "containerEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN_FOR_HELPERS4}"
  },
  "features": {
    "ghcr.io/helpers4/devcontainer/org-workspace:1": {
      "autoDiscover": "public,private,internal,fork",
      "exclude": "helpers4.github.io"
    },
    // ── Infrastructure ───────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/shell-history:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {},
    // ── Dev environment ──────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/helpers4/devcontainer/git-absorb:1": {},
    "ghcr.io/helpers4/devcontainer/essential-dev:1": {},
    "ghcr.io/helpers4/devcontainer/github-dev:1": {},
    "ghcr.io/helpers4/devcontainer/auto-header:1": {
      "projectName": "helpers4",
      "license": "LGPL-3.0-or-later"
    },
    // ── AI ───────────────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/copilot-dev:1": {},
    "ghcr.io/helpers4/devcontainer/claude-dev:1": {
      "installCli": true,
      "remoteControl": true,
      "remoteControlAutoTrust": true
    },
    //"ghcr.io/helpers4/devcontainer/mistral-dev:1": {},
    "ghcr.io/helpers4/devcontainer/cline-dev:1": {},
    //"ghcr.io/helpers4/devcontainer/kimi-dev:1": {},
    // ── Rust ─────────────────────────────────────────────────────────────────
    "ghcr.io/devcontainers/features/rust:1": {},
    // ── JavaScript ───────────────────────────────────────────────────────────
    "ghcr.io/helpers4/devcontainer/typescript-dev:1": {},
    "ghcr.io/helpers4/devcontainer/pnpm-store:1": {},
    "ghcr.io/helpers4/devcontainer/nub:1": {},
    "ghcr.io/helpers4/devcontainer/package-auto-install:1": {
      "autoDiscover": true
    },
    "ghcr.io/helpers4/devcontainer/vite-plus:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck"
      ]
    }
  },
  // Only `website` (Astro) runs a dev server; other repos have none to forward.
  "forwardPorts": [
    4321
  ],
  "portsAttributes": {
    "4321": {
      "label": "website — Astro dev server",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "node",
  "onCreateCommand": "git config --local --unset core.hooksPath || true"
}